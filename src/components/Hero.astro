---
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-status">
        <span class="status-indicator"></span>
        <span>AI/ML Engineer · 4 Years Experience · Bengaluru, India</span>
      </div>

      <h1 class="hero-name">Ravivarma Patturi</h1>
      
      <p class="hero-positioning">
        AI Engineer: production agentic systems &amp; edge inference
      </p>

      <p class="hero-bio">
        I design and deploy production-grade Generative AI, multi-agent decision systems, and high-throughput inference pipelines for leading U.S. healthcare payers and providers. Alongside enterprise delivery, I follow on-device AI out of personal interest and build in that space: <strong>InferEdge AI</strong> (on-device speech-to-speech with <strong>VaayuEdge</strong>), <strong>Neural Mastery</strong> (1,800+ page AI engineering platform), published Hugging Face models, and technical teaching.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">
          <span>Hire / Contact</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/assets/pdf/Ravivarma_Patturi_Resume.pdf" class="btn btn-secondary" download="Ravivarma_Patturi_Resume.pdf" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download résumé</span>
        </a>
      </div>

      <div class="hero-quick-links">
        <span class="quick-link-label">Direct:</span>
        <a href="mailto:patturiravivarma@gmail.com" class="quick-link">patturiravivarma@gmail.com</a>
        <span class="sep">/</span>
        <a href="https://linkedin.com/in/ravivarma-patturi" target="_blank" rel="noopener noreferrer" class="quick-link">LinkedIn</a>
        <span class="sep">/</span>
        <a href="https://github.com/ravivarmapatturi" target="_blank" rel="noopener noreferrer" class="quick-link">GitHub</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="photo-wrapper">
        <img
          src="/assets/img/PROFILE.png"
          alt="Ravivarma Patturi, AI and Machine Learning Engineer"
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          class="hero-photo"
        />
        <div class="photo-badge">
          <span class="badge-role">Current: AI Engineer @ Autonomize AI</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 768px) {
    .hero-section {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3.5rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-visual {
      order: -1;
      justify-self: start;
    }
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3125rem 0.75rem;
    background-color: var(--accent-light);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }
  .hero-name {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text-main);
    margin-bottom: 0.875rem;
  }
  .hero-positioning {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin-bottom: 1.25rem;
  }
  .hero-bio {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 680px;
    margin-bottom: 2rem;
  }
  .hero-bio strong {
    color: var(--text-main);
    font-weight: 600;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .hero-quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
  .quick-link-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .quick-link {
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .quick-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .sep {
    color: var(--border);
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .photo-wrapper {
    position: relative;
    width: 280px;
    height: 280px;
  }
  @media (max-width: 640px) {
    .photo-wrapper {
      width: 220px;
      height: 220px;
    }
  }
  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 2px solid var(--border);
    background-color: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .photo-badge {
    position: absolute;
    bottom: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }
  .badge-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-main);
  }
</style>
