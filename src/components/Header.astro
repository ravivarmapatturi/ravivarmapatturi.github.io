---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#" class="brand" aria-label="Ravivarma Patturi Home">
      <span class="brand-monogram">RP</span>
      <span class="brand-name">Ravivarma Patturi</span>
    </a>

    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="#experience" class="nav-link">Experience</a>
      <a href="#building" class="nav-link">Building</a>
      <a href="#projects" class="nav-link">Projects</a>
      <a href="#writing-videos" class="nav-link">Videos</a>
      <a href="#skills" class="nav-link">Skills</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button class="mobile-menu-toggle" id="mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg class="menu-open-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="menu-close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="container mobile-nav-inner">
      <a href="#experience" class="mobile-link">Experience</a>
      <a href="#building" class="mobile-link">Building</a>
      <a href="#projects" class="mobile-link">Projects</a>
      <a href="#writing-videos" class="mobile-link">Videos & Writing</a>
      <a href="#skills" class="mobile-link">Skills</a>
      <a href="#contact" class="mobile-link">Contact</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .brand-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent-light);
    color: var(--accent);
    border: 1px solid var(--accent-border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s ease;
    padding: 0.25rem 0.125rem;
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 0.5rem;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .menu-close-icon {
    display: none;
  }
  .mobile-nav {
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }
  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mobile-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-main);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .mobile-link:last-child {
    border-bottom: none;
  }
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-nav');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.hidden = isExpanded;
      const openIcon = btn.querySelector('.menu-open-icon');
      const closeIcon = btn.querySelector('.menu-close-icon');
      if (openIcon && closeIcon) {
        if (!isExpanded) {
          openIcon.style.display = 'none';
          closeIcon.style.display = 'block';
        } else {
          openIcon.style.display = 'block';
          closeIcon.style.display = 'none';
        }
      }
    });

    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        const openIcon = btn.querySelector('.menu-open-icon');
        const closeIcon = btn.querySelector('.menu-close-icon');
        if (openIcon && closeIcon) {
          openIcon.style.display = 'block';
          closeIcon.style.display = 'none';
        }
      });
    });
  }
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
